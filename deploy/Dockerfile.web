# Wegener's Dream 뷰어 이미지.
#
# 자료(index.json·배경·해안선·화석)는 굽지 않는다. /srv/WegenersDream/data 에서 마운트해 본다.
# 파이프라인도 넣지 않는다 — netCDF4·shapely 가 딸려 오면 이미지가 몇 배로 커진다.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 사내 CA — GSM 과 같은 까닭이다(deploy/ca/README.md). 없으면 넘어간다(망 밖에서 굽는 경우).
COPY deploy/ca/ /usr/local/share/ca-certificates/wegenersdream/
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && update-ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# 의존성을 코드보다 먼저 깐다 — 코드만 고쳤을 때 이 층을 다시 받지 않는다
#
# **pip 을 먼저 올린다** (koprifossillab 056). 베이스 이미지에 든 pip 은 그 파이썬 판이 나올 때
# 묶인 것이라 베이스를 새로 받아도 안 올라간다(3.12 는 25.0.1 이었다). 26.1 이
# 악성 wheel·인덱스로 설치 경로 밖에 파일을 쓰는 결함들을 고친 판이다.
COPY requirements-web.txt ./
RUN pip install --upgrade "pip>=26.1" \
 && pip install -r requirements-web.txt

COPY . .

RUN cd web && WEGENER_SECRET_KEY=build-only python manage.py collectstatic --noinput

ENV HOME=/tmp
EXPOSE 9090
ENTRYPOINT ["/app/deploy/entrypoint-web.sh"]
